# Copy to .env and adjust. Never commit the real .env.

APP_NAME=Grand Aurora Hotel
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# SQLite needs no setup and is the default.
DATABASE_URL=sqlite+aiosqlite:///./hotel.db
# PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://hotel:hotel@localhost:5432/hotel_db
DB_ECHO=false

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# APP_ENV=production refuses to start while this is still the value below,
# shorter than 32 characters, DEBUG is true, or CORS_ORIGINS is "*".
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Brute-force protection on the sign-in endpoint. Keyed by client IP, so a
# deployment behind a proxy needs that proxy to set a trustworthy client IP.
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10/minute
PASSWORD_CHANGE_RATE_LIMIT=5/minute
# Where the limiter keeps its counters. In-memory is per-process, so with more
# than one worker or container each keeps its own and the effective limit is
# multiplied by their number.
RATE_LIMIT_STORAGE_URI=memory://
# Per-account brake on top of the per-IP limit: the IP limit alone does not
# stop attempts spread across many hosts against one address.
ACCOUNT_LOCK_AFTER_FAILURES=10
ACCOUNT_LOCK_MINUTES=15

CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Host header allow-list; "*" disables the check. Set real hostnames in production.
TRUSTED_HOSTS=*

CURRENCY=AZN
CURRENCY_SYMBOL=₼
TAX_RATE=0.18
CHECK_IN_HOUR=14
CHECK_OUT_HOUR=12
