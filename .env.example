# Copy to .env and adjust. Never commit the real .env.

APP_NAME=Grand Aurora Hotel
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# SQLite needs no setup and is the default.
DATABASE_URL=sqlite+aiosqlite:///./hotel.db
# PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://hotel:hotel@localhost:5432/hotel_db
DB_ECHO=false

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

CURRENCY=AZN
CURRENCY_SYMBOL=₼
TAX_RATE=0.18
CHECK_IN_HOUR=14
CHECK_OUT_HOUR=12
